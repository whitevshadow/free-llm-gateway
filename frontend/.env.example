# Open WebUI configuration — copy to .env (or set these on your frontend service).
#
# Point the UI at your backend gateway's OpenAI-compatible endpoint:
OPENAI_API_BASE_URL=https://your-gateway-url/v1
# Must EQUAL the backend's GATEWAY_API_KEY:
OPENAI_API_KEY=sk-gw-REPLACE_WITH_YOUR_GATEWAY_KEY

# Require login; first account created becomes the admin.
WEBUI_AUTH=true
# Allow the first signup; flip to false once your admin account exists.
ENABLE_SIGNUP=true

# We only use the gateway, not Ollama.
ENABLE_OLLAMA_API=false
WEBUI_NAME=Lite-LLM

# Pre-select the 4 reliability-core models.
DEFAULT_MODELS=gpt-oss-120b,llama-3.3-70b,gpt-oss-20b,llama-3.1-8b
