# ──────────────────────────────────────────────────────────────────────────────
#  Backend config — for running the API OUTSIDE Docker (uvicorn directly).
#  If you use docker compose, configure the ROOT .env instead; this file is not
#  read by the container.
#
#  Copy to backend/.env. Never commit it.
# ──────────────────────────────────────────────────────────────────────────────

# ── Database (POSTGRES ONLY) ─────────────────────────────────────────────────
# SQLite is NOT supported: the app raises on a sqlite:// URL at startup. The
# schema depends on generated columns, plpgsql triggers, native enums, composite
# foreign keys and views, and SQLite has none of them. Those constraints are what
# make it impossible for one user to spend another user's API quota — silently
# dropping them would be worse than refusing to boot.
#
# Spin one up:
#   docker run -d --name gw -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=gateway \
#     -p 5432:5432 postgres:16-alpine
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/gateway

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Security ─────────────────────────────────────────────────────────────────
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-64-char-hex-string

# Encrypts users' provider keys at rest. If unset, one is derived from SECRET_KEY
# (dev only, logs a warning) — which means rotating SECRET_KEY would brick every
# stored key. Set a dedicated one in production and back it up:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# The first ADMIN. Created on first startup along with their gateway key, which
# is printed ONCE in the logs. There is no signup — that key is how you get in,
# and how you mint keys for everyone else.
OWNER_EMAIL=admin@localhost

# /v1 auth is DB-issued gateway keys only (Authorization: Bearer, or x-api-key).
# false opens the CHAT endpoints for local curling; it does NOT open /v1/admin/*.
REQUIRE_GATEWAY_AUTH=true

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=*

# ── LLM request defaults ─────────────────────────────────────────────────────
REQUEST_TIMEOUT=120
DEFAULT_MAX_TOKENS=2048

# ── NO PROVIDER API KEYS HERE ────────────────────────────────────────────────
# There is deliberately no GROQ_API_KEY / NVIDIA_API_KEY / OPENAI_API_KEY. An env
# var is process-global, so a key here would be shared by every user of the
# gateway — the exact bug the multi-user rewrite removed. Users add their own
# keys in the UI; each is encrypted, scoped to that user, and passed per-request
# into LiteLLM rather than through os.environ.
