# ──────────────────────────────────────────────────────────
# Multi-LLM Gateway Platform — Environment Configuration
# ──────────────────────────────────────────────────────────
# Copy this file to .env and fill in your API keys.
# NEVER commit the .env file to Git.
# ──────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=True
ENVIRONMENT=development
LOG_LEVEL=INFO

# ── Security ─────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-64-char-hex-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── CORS ─────────────────────────────────────────────────
# Comma-separated origins. Use * for development only.
CORS_ORIGINS=*

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT=60/minute

# ── Database ─────────────────────────────────────────────
DATABASE_URL=sqlite:///./gateway.db

# ── LLM Request Defaults ────────────────────────────────
REQUEST_TIMEOUT=120
DEFAULT_MAX_TOKENS=2048
DEFAULT_TEMPERATURE=0.7
MAX_RETRIES=2

# ── Smart Router / Model Pool ───────────────────────────
MODEL_POOL_PATH=config/model_pool.yaml
# Where unknown model names (e.g. Claude Code's "claude-3-5-sonnet") get routed.
DEFAULT_VIRTUAL_MODEL=auto

# ── Gateway Auth (for /v1 endpoints used by Claude Code etc.) ──
# The token external clients must present (Authorization: Bearer  OR  x-api-key).
# Leave REQUIRE_GATEWAY_AUTH=false for local dev (open access).
GATEWAY_API_KEY=
REQUIRE_GATEWAY_AUTH=false

# ── FREE Provider API Keys ──────────────────────────────
# Add MULTIPLE keys per provider (create several free accounts) to multiply your
# limits — the Router rotates across them and cools down any that hit a 429.
# Just append _2, _3, ... and add a matching deployment in config/model_pool.yaml.
# Only the keys you fill in are used; the rest of the pool is skipped automatically.

# Groq   → https://console.groq.com/keys   (gpt-oss-120b/20b, Llama, Qwen, DeepSeek-distill)
GROQ_API_KEY_1=
GROQ_API_KEY_2=

# OpenRouter → https://openrouter.ai/keys  (many ':free' models behind one key)
OPENROUTER_API_KEY_1=

# Google AI Studio → https://aistudio.google.com/apikey  (Gemini 2.x free tier)
GEMINI_API_KEY_1=

# Cerebras → https://cloud.cerebras.ai     (fast free Llama / Qwen / gpt-oss)
CEREBRAS_API_KEY_1=

# GitHub Models → https://github.com/settings/tokens  (free with a GitHub PAT)
GITHUB_MODELS_TOKEN=

# Mistral → https://console.mistral.ai/api-keys
MISTRAL_API_KEY_1=

# DeepSeek (direct) → https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY_1=

# NVIDIA NIM → https://build.nvidia.com  (integrate.api.nvidia.com/v1, free dev tier)
NVIDIA_API_KEY_1=

# Ollama (local, no key needed) — runs models on your machine
OLLAMA_API_BASE=http://localhost:11434
