**/__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
venv/
.venv/

# Secrets & local config (provide at runtime via env vars)
.env
*.local

# Local databases / data
*.db
*.sqlite
data/

# Tests not needed in the runtime image
tests/
