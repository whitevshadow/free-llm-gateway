# Build context = repo root. Keep it small and never ship secrets.
.git
.gitignore

# Secrets — MUST never enter the image.
.env
**/.env
!.env.example
!**/.env.example

# The API image no longer builds or serves a UI — the dashboard is its own image
# (frontend/Dockerfile). Excluding the whole directory keeps ~2,100 source files
# and a 750-package node_modules out of this build context entirely.
frontend

# The upstream OmniRoute checkout, kept for reference. 10,000+ files that belong
# in no image.
OmniRoute

# A stale local build would silently shadow what the image expects.
backend/static

# Python noise
**/__pycache__
**/*.pyc
.pytest_cache
.venv
venv

# Docs / deploy configs not needed at runtime
*.md
deploy
