# ── Python ──
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.ruff_cache/
**/venv/
**/.venv/
**/env/

# ── Node / frontend ──
**/node_modules/
**/dist/
**/dist-ssr/
**/.eslintcache

# ── Secrets & local config (pass at runtime via --env-file) ──
**/.env
**/.env.local
**/*.local

# ── Databases ──
**/*.db
**/*.sqlite

# ── Git / IDE / OS ──
.git/
.gitignore
**/.vscode/
**/.idea/
.DS_Store
Thumbs.db

# ── Docs / misc not needed in the image ──
README.md
