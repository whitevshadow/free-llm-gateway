# ─────────────────────────────────────────────────────────────────────────────
#  Copy to .env, fill in the two secrets, then:  docker compose up -d --build
# ─────────────────────────────────────────────────────────────────────────────

# ── Secrets (REQUIRED — compose refuses to start without them) ───────────────

# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Encrypts every user's provider API key at rest.
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠ SET THIS ONCE AND BACK IT UP. If it changes, every stored provider key
#   becomes undecryptable and every user has to re-enter their keys.
ENCRYPTION_KEY=

# ── Database ────────────────────────────────────────────────────────────────
# Postgres only. SQLite is not supported and the app will refuse to start on it:
# the schema needs generated columns, triggers, enums and composite foreign keys,
# and those constraints are what stop one user's traffic being billed to another
# user's API key.
POSTGRES_USER=gateway
POSTGRES_PASSWORD=gateway
POSTGRES_DB=gateway

# ── App ─────────────────────────────────────────────────────────────────────
PORT=8000
OWNER_EMAIL=admin@localhost

# The first admin user + their gateway key are created on first startup, and the
# key is printed ONCE in the logs:
#     docker compose logs app | grep -A2 "BOOTSTRAP ADMIN KEY"
# There is no signup — that key is how you get in, and how you mint keys for
# everyone else.

# false opens the CHAT endpoints for local curling. It does NOT open /v1/admin/*
# — an admin key is always required there, even with this off.
REQUIRE_GATEWAY_AUTH=true

ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO
CORS_ORIGINS=*
REQUEST_TIMEOUT=120

# ── There are no provider API keys here, on purpose ─────────────────────────
# No GROQ_API_KEY, no NVIDIA_API_KEY, no OPENAI_API_KEY. An environment variable
# is process-global: a key set here would be shared by every user of the gateway,
# which is precisely the bug the multi-user design exists to prevent.
#
# Users add their OWN keys in the UI (Providers & keys), or via
# POST /v1/me/provider-keys. Each is encrypted, scoped to that user, and passed
# per-request into LiteLLM — never through os.environ.
