# Root .env.example — copy to .env for docker-compose.
# Used by docker-compose for ${VAR} interpolation.
# This is SEPARATE from backend/.env (the backend's own config).
#
# Generate a key with:  python -c "import secrets; print('sk-gw-'+secrets.token_hex(24))"
GATEWAY_API_KEY=sk-gw-REPLACE_WITH_YOUR_OWN_KEY
# true = external clients must send the key (required when the gateway is public).
REQUIRE_GATEWAY_AUTH=true
